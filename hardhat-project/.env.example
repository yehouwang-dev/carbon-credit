# ============================================================
#  碳信用平台 - Hardhat 环境配置
#  使用说明：将此文件复制为 .env 并填入你的真实值
#    cp .env.example .env
# ============================================================

# ---------- 1. 私钥 ----------
# 部署账户的私钥（不要泄露！仅限测试）
# 格式：0x 开头的 64 位十六进制字符串
PRIVATE_KEY="YOUR_PRIVATE_KEY_HERE"

# ---------- 2. RPC 地址 ----------
# Sepolia 测试网 RPC（可替换为你的节点地址）
# 推荐免费节点：
#   - Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
#   - Infura:  wss://sepolia.infura.io/v3/YOUR_PROJECT_ID
#   - Ankr:    https://rpc.ankr.com/eth_sepolia
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# ---------- 3. Etherscan API Key ----------
# 用于合约部署后自动验证（可选）
# 获取地址：https://docs.etherscan.io/getting-started/view-api-key-access
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY_HERE"
